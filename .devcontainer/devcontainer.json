{
  "name": "TurtleBot3 – ROS 2 Humble",
  // Gleiches Dockerfile auf allen Branches -> Docker-Cache trifft, kein Neu-Download.
  // Zusaetzlicher fester Name, damit das Image in "docker images" leicht zu finden ist.
  "build": {
    "dockerfile": "Dockerfile",
    "options": ["--tag=turtlebot3-urmc:humble"]
  },
  "runArgs": [
    "--network=host",
    "--privileged",
    "-e", "DISPLAY=${localEnv:DISPLAY}",
    "-v", "/tmp/.X11-unix:/tmp/.X11-unix"
  ],
  // NVIDIA-GPU in den Container (TensorRT/YOLO). "optional": mit GPU und NVIDIA Container
  // Toolkit auf dem Host startet der Container mit --gpus all, ohne beides trotzdem.
  // Host einmalig einrichten: docs/Befehle.md, Abschnitt "GPU im Container".
  "hostRequirements": { "gpu": "optional" },
  "mounts": [
    "source=/dev,target=/dev,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "Ranch-Hand-Robotics.rde-ros-2",
        "Ranch-Hand-Robotics.urdf-editor",
        "ms-vscode.cpptools",
        "ms-python.python",
        // Statt Pylance: Pylance meldete in diesem Container immer wieder Builtins
        // (int, len, super ...) als "not defined"; reines Pyright mit gleichem Kern nicht.
        "ms-pyright.pyright",
        "anthropic.claude-code",
        "ms-azuretools.vscode-containers"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.languageServer": "None",
        "python.analysis.typeCheckingMode": "off",
        // ROS-Pakete fuer Autovervollstaendigung (rclpy, Nachrichtentypen, eigenes follow_lane_msg).
        // OpenCV-Stubs liegen in ./typings -- Pyright findet den Ordner von selbst.
        "python.analysis.extraPaths": [
          "/opt/ros/humble/lib/python3.10/site-packages",
          "/opt/ros/humble/local/lib/python3.10/dist-packages",
          "/root/turtlebot3_ws/install/turtlebot3_msgs/local/lib/python3.10/dist-packages",
          "/workspaces/TurtleBot3-URMC/workspace/install/follow_lane_msg/local/lib/python3.10/dist-packages",
          "/workspaces/TurtleBot3-URMC/workspace/install/Follow_Lane/lib/python3.10/site-packages"
        ]
      }
    }
  },
  "containerEnv": { "ROS_DOMAIN_ID": "33" },
  // Laeuft auf dem HOST, bevor der Container startet. Ohne die Freigabe scheitert jede
  // GUI (rqt, rviz) mit "Authorization required" -- der Container laeuft als root,
  // der X-Socket gehoert aber dem Host-User. xhost ist nicht persistent, daher bei
  // jedem Containerstart neu. "|| true": auf Hosts ohne X (z.B. SSH) nicht abbrechen.
  "initializeCommand": "xhost +local:root || true",
  // turtlebot3_ws ist jetzt im Image (Dockerfile); hier nur noch Aliase, kein Download.
  "postCreateCommand": "echo '[ -f /workspaces/TurtleBot3-URMC/workspace/install/setup.bash ] && source /workspaces/TurtleBot3-URMC/workspace/install/setup.bash' >> ~/.bashrc && echo \"alias tb='bash /workspaces/TurtleBot3-URMC/scripts/tb/launch.sh'\" >> ~/.bashrc && echo \"alias botssh='bash /workspaces/TurtleBot3-URMC/scripts/tb/ssh-bot.sh'\" >> ~/.bashrc && echo \"alias botcheck='bash /workspaces/TurtleBot3-URMC/scripts/tb/bot-check.sh'\" >> ~/.bashrc && echo \"alias botup='bash /workspaces/TurtleBot3-URMC/scripts/tb/bot-up.sh'\" >> ~/.bashrc && echo \"alias botdown='bash /workspaces/TurtleBot3-URMC/scripts/tb/bot-down.sh'\" >> ~/.bashrc && echo \"alias lanup='bash /workspaces/TurtleBot3-URMC/scripts/tb/net-lan.sh up'\" >> ~/.bashrc && echo \"alias landown='bash /workspaces/TurtleBot3-URMC/scripts/tb/net-lan.sh down'\" >> ~/.bashrc && echo \"alias lanstatus='bash /workspaces/TurtleBot3-URMC/scripts/tb/net-lan.sh status'\" >> ~/.bashrc && echo \"alias lansetup='bash /workspaces/TurtleBot3-URMC/scripts/tb/bot-lan-setup.sh'\" >> ~/.bashrc"
}
